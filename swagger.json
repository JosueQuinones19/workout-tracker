{
  "swagger": "2.0",
  "info": {
    "title": "PowerLog: Fitness Tracking API",
    "description": "API for tracking exercises and workout logs. Part of the PowerLog fitness tracking platform. POST and DELETE routes for exercises require Google OAuth login.",
    "version": "1.0.0"
  },
  "host": "workout-tracker-tnwm.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "tags": [
    {
      "name": "Exercises",
      "description": "CRUD operations for exercises"
    },
    {
      "name": "Workout Logs",
      "description": "CRUD operations for workout logs"
    },
    {
      "name": "Auth",
      "description": "Google OAuth authentication"
    }
  ],
  "paths": {
    "/exercises/": {
      "get": {
        "tags": ["Exercises"],
        "summary": "Get all exercises",
        "description": "Returns a list of all exercises in the database.",
        "responses": {
          "200": {
            "description": "A list of exercises"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": ["Exercises"],
        "summary": "Create a new exercise",
        "description": "Creates a new exercise. Requires Google OAuth login.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name", "muscleGroup", "equipment", "sets", "reps", "difficulty", "description"],
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Bench Press"
                },
                "muscleGroup": {
                  "type": "string",
                  "example": "Chest"
                },
                "equipment": {
                  "type": "string",
                  "example": "Barbell"
                },
                "sets": {
                  "type": "integer",
                  "example": 4
                },
                "reps": {
                  "type": "integer",
                  "example": 10
                },
                "difficulty": {
                  "type": "string",
                  "example": "Intermediate"
                },
                "description": {
                  "type": "string",
                  "example": "Flat barbell bench press targeting chest, shoulders, and triceps"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Exercise created successfully"
          },
          "400": {
            "description": "Bad Request - missing required fields"
          },
          "401": {
            "description": "Unauthorized - login required"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/exercises/{id}": {
      "get": {
        "tags": ["Exercises"],
        "summary": "Get an exercise by ID",
        "description": "Returns a single exercise by its MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The exercise ID"
          }
        ],
        "responses": {
          "200": {
            "description": "The exercise object"
          },
          "400": {
            "description": "Bad Request - invalid ID format"
          },
          "404": {
            "description": "Exercise not found"
          }
        }
      },
      "put": {
        "tags": ["Exercises"],
        "summary": "Update an exercise",
        "description": "Updates all fields of an existing exercise by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The exercise ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name", "muscleGroup", "equipment", "sets", "reps", "difficulty", "description"],
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Incline Bench Press"
                },
                "muscleGroup": {
                  "type": "string",
                  "example": "Upper Chest"
                },
                "equipment": {
                  "type": "string",
                  "example": "Barbell"
                },
                "sets": {
                  "type": "integer",
                  "example": 3
                },
                "reps": {
                  "type": "integer",
                  "example": 12
                },
                "difficulty": {
                  "type": "string",
                  "example": "Intermediate"
                },
                "description": {
                  "type": "string",
                  "example": "Incline barbell press targeting upper chest and front delts"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Exercise updated successfully"
          },
          "400": {
            "description": "Bad Request - missing fields or invalid ID"
          },
          "404": {
            "description": "Exercise not found"
          }
        }
      },
      "delete": {
        "tags": ["Exercises"],
        "summary": "Delete an exercise",
        "description": "Deletes an exercise by its ID. Requires Google OAuth login.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The exercise ID"
          }
        ],
        "responses": {
          "204": {
            "description": "Exercise deleted successfully"
          },
          "400": {
            "description": "Bad Request - invalid ID format"
          },
          "401": {
            "description": "Unauthorized - login required"
          },
          "404": {
            "description": "Exercise not found"
          }
        }
      }
    },
    "/workout-logs/": {
      "get": {
        "tags": ["Workout Logs"],
        "summary": "Get all workout logs",
        "description": "Returns a list of all workout logs in the database.",
        "responses": {
          "200": {
            "description": "A list of workout logs"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": ["Workout Logs"],
        "summary": "Create a new workout log",
        "description": "Creates a new workout log entry.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["exerciseId", "date", "setsCompleted", "repsCompleted", "weight"],
              "properties": {
                "exerciseId": {
                  "type": "string",
                  "example": "64abc123def4567890ghij12"
                },
                "date": {
                  "type": "string",
                  "example": "2026-10-08"
                },
                "setsCompleted": {
                  "type": "integer",
                  "example": 4
                },
                "repsCompleted": {
                  "type": "integer",
                  "example": 10
                },
                "weight": {
                  "type": "number",
                  "example": 135
                },
                "notes": {
                  "type": "string",
                  "example": "Felt strong, increased weight by 5 lbs"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Workout log created successfully"
          },
          "400": {
            "description": "Bad Request - missing required fields"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/workout-logs/{id}": {
      "get": {
        "tags": ["Workout Logs"],
        "summary": "Get a workout log by ID",
        "description": "Returns a single workout log by its MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The workout log ID"
          }
        ],
        "responses": {
          "200": {
            "description": "The workout log object"
          },
          "400": {
            "description": "Bad Request - invalid ID format"
          },
          "404": {
            "description": "Workout log not found"
          }
        }
      },
      "put": {
        "tags": ["Workout Logs"],
        "summary": "Update a workout log",
        "description": "Updates all fields of an existing workout log by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The workout log ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["exerciseId", "date", "setsCompleted", "repsCompleted", "weight"],
              "properties": {
                "exerciseId": {
                  "type": "string",
                  "example": "64abc123def4567890ghij12"
                },
                "date": {
                  "type": "string",
                  "example": "2026-10-09"
                },
                "setsCompleted": {
                  "type": "integer",
                  "example": 3
                },
                "repsCompleted": {
                  "type": "integer",
                  "example": 8
                },
                "weight": {
                  "type": "number",
                  "example": 140
                },
                "notes": {
                  "type": "string",
                  "example": "Reduced reps, heavier weight"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Workout log updated successfully"
          },
          "400": {
            "description": "Bad Request - missing fields or invalid ID"
          },
          "404": {
            "description": "Workout log not found"
          }
        }
      },
      "delete": {
        "tags": ["Workout Logs"],
        "summary": "Delete a workout log",
        "description": "Deletes a workout log by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The workout log ID"
          }
        ],
        "responses": {
          "204": {
            "description": "Workout log deleted successfully"
          },
          "400": {
            "description": "Bad Request - invalid ID format"
          },
          "404": {
            "description": "Workout log not found"
          }
        }
      }
    },
    "/auth/google": {
      "get": {
        "tags": ["Auth"],
        "summary": "Login with Google",
        "description": "Redirects to Google OAuth login page.",
        "responses": {
          "302": {
            "description": "Redirect to Google login"
          }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "tags": ["Auth"],
        "summary": "Google OAuth callback",
        "description": "Handles the Google OAuth callback after login.",
        "responses": {
          "302": {
            "description": "Redirect to profile on success, home on failure"
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "tags": ["Auth"],
        "summary": "Logout",
        "description": "Logs out the current user and redirects to home.",
        "responses": {
          "302": {
            "description": "Redirect to home page"
          }
        }
      }
    }
  }
}
